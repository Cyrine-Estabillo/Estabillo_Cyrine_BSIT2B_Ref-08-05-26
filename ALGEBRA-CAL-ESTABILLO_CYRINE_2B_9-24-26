#ALGEBRA
def solve_linear():
    if a == 0:
        if b == c:
            return "Infinitely many solutions)."
        else:
            return "No solution."
    x = (c - b) / a
    return f"x = {x:.6f}"
    
def solve_quadratic():
    if a == 0:
        return f"Linear case: {solve_linear(b, 0, -c)}"

    discriminant = b**2 - 4*a*c
    if discriminant > 0:
        root1 = (-b + math.sqrt(discriminant)) / (2 * a)
        root2 = (-b - math.sqrt(discriminant)) / (2 * a)
        return f"Two real roots: x1 = {root1:.6f}, x2 = {root2:.6f}"
    elif discriminant == 0:
        root = -b / (2 * a)
        return f"One real double root: x = {root:.6f}"
    else:
        real_part = -b / (2 * a)
        imag_part = math.sqrt(-discriminant) / (2 * a)
        return f"Complex roots: x1 = {real_part:.6f} + {imag_part:.6f}i, x2 = {real_part:.6f} - {imag_part:.6f}i"

def evaluate_f(a, b, c, x):
    return a * x**2 + b * x + c

